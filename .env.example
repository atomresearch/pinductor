# --- LLM access (required for ours / curtis_their / ours_heur_llm conditions)
OPEN_ROUTER_KEY=

# Optional: backup key used when the primary returns 402/429.
# OPEN_ROUTER_KEY_BACKUP=

# Optional: pin LLM (default qwen/qwen3.6-plus).
# Used by E4 to switch to e.g. anthropic/claude-opus-4.7 or qwen/qwen3-14b.
# PAPER_LLM_MODEL=qwen/qwen3.6-plus

# Optional: enable OpenRouter prompt caching (default: 0 / off).
# OPENROUTER_PROMPT_CACHE=0

# Optional: pin OpenRouter provider for reproducibility.
# OPENROUTER_PIN_PROVIDER=

# --- WandB (optional). If WANDB_API_KEY is unset, logging is disabled.
# WANDB_API_KEY=
# WANDB_PROJECT=pinductor
# WANDB_ENTITY=

# --- Misc
# Generate per-episode GIFs (perf overhead, default: 0).
# ENABLE_VIZ=0
